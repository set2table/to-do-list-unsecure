# Gere par Ansible - ne pas modifier a la main. Lisible par root et le groupe todolist uniquement.
DJANGO_SECRET_KEY={{ todolist_secret_key }}
TODOLIST_ADMIN_PASSWORD={{ todolist_admin_password }}
DJANGO_DEBUG={{ 'true' if app_env == 'dev' else 'false' }}
DJANGO_ALLOWED_HOSTS={{ ansible_host }},{{ inventory_hostname }},localhost,127.0.0.1
# TP en HTTP : en HTTPS, passer a true (cookies Secure)
DJANGO_HTTPS=false
DJANGO_DB_PATH={{ app_dir }}/data/db.sqlite3
