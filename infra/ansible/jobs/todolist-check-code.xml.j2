<?xml version='1.1' encoding='UTF-8'?>
<!-- Gere par Ansible (infra/ansible/jobs) : toute modif dans l'UI sera ecrasee. -->
<project>
  <actions/>
  <description>Controle du code d'une branche : secrets (gitleaks), tests Django + couverture, CVE des dependances (pip-audit), quality gate SonarQube.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <jenkins.model.BuildDiscarderProperty>
      <strategy class="hudson.tasks.LogRotator">
        <daysToKeep>90</daysToKeep>
        <numToKeep>50</numToKeep>
        <artifactDaysToKeep>-1</artifactDaysToKeep>
        <artifactNumToKeep>-1</artifactNumToKeep>
      </strategy>
    </jenkins.model.BuildDiscarderProperty>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition>
          <name>BRANCHE</name>
          <description>Branche git a traiter (ex : main, feature/xxx)</description>
          <defaultValue>main</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <scm class="hudson.plugins.git.GitSCM" plugin="git">
    <configVersion>2</configVersion>
    <userRemoteConfigs>
      <hudson.plugins.git.UserRemoteConfig>
        <url>{{ app_repo }}</url>
      </hudson.plugins.git.UserRemoteConfig>
    </userRemoteConfigs>
    <branches>
      <hudson.plugins.git.BranchSpec>
        <name>refs/heads/${BRANCHE}</name>
      </hudson.plugins.git.BranchSpec>
    </branches>
    <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
    <submoduleCfg class="empty-list"/>
    <extensions/>
  </scm>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/>
  <concurrentBuild>false</concurrentBuild>
  <builders>
      <hudson.tasks.Shell>
        <command>#!/bin/bash
# todolist-check-code - etape 1 : secrets, tests, dependances
# La politique (gate bloquante ou non) est fixee ici, dans la config du job,
# modifiable par un admin Jenkins uniquement - pas par la branche testee.
set -uo pipefail
GATE_BLOQUANTE={{ 'true' if ci_gate_bloquante else 'false' }}
SEVERITE_BLOQUANTE=CRITICAL

case "$BRANCHE" in
  ""|*[!A-Za-z0-9._/-]*) echo "Nom de branche invalide : '$BRANCHE'"; exit 1 ;;
esac
echo "=== todolist-check-code : branche $BRANCHE, commit $GIT_COMMIT (gate bloquante : $GATE_BLOQUANTE)"
: &gt; gate-resultat.txt
resultat() { printf '%-28s : %s\n' "$1" "$2" | tee -a gate-resultat.txt; }

# ---------------------------------------------------------------- 1. secrets
echo "=== [1/3] Secrets dans le code (gitleaks)"
if gitleaks dir . --no-banner --redact --exit-code 1 --report-path gitleaks.json; then
  resultat "Secrets (gitleaks)" "OK"
else
  resultat "Secrets (gitleaks)" "KO - secret(s) en clair dans le code, voir gitleaks.json"
fi

# ---------------------------------------------------------------- 2. tests
echo "=== [2/3] Tests unitaires Django"
python3 -m venv .venv
. .venv/bin/activate
pip install -q --upgrade pip
python3 - &gt; requirements-ci.txt &lt;&lt;'EOF'
import tomllib
pkgs = tomllib.load(open("Pipfile", "rb"))["packages"]
for name, spec in pkgs.items():
    if isinstance(spec, dict):
        spec = spec.get("version", "*")
    print(name if spec in ("*", "") else name + spec)
EOF
echo "Dependances du Pipfile :"; cat requirements-ci.txt
pip install -q -r requirements-ci.txt coverage || { echo "ECHEC : installation des dependances"; exit 1; }

# cle jetable, propre a ce build : ce n'est pas un secret
export DJANGO_SECRET_KEY="ci-$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')"
if coverage run --source=tasks,todo --omit='*/migrations/*,*/tests.py,todo/asgi.py,todo/wsgi.py' \
     manage.py test --noinput -v 2; then
  coverage xml -o coverage.xml
  coverage report
  resultat "Tests unitaires" "OK"
else
  resultat "Tests unitaires" "KO"
  echo "=================================================================="
  echo " ECHEC : les tests unitaires ne passent pas. Rien ne sera deploye."
  echo "=================================================================="
  exit 1
fi

# ---------------------------------------------------------------- 3. pip-audit
echo "=== [3/3] Analyse des dependances (pip-audit + severite OSV)"
# venv separe : les vieilles versions de requests/urllib3 de l'appli cassent pip-audit
deactivate
python3 -m venv .venv-outils
.venv-outils/bin/pip install -q pip-audit
rm -f pip-audit.json
.venv-outils/bin/pip-audit -r requirements-ci.txt -f json -o pip-audit.json --progress-spinner off
python3 - "$SEVERITE_BLOQUANTE" &gt;&gt; gate-resultat.txt &lt;&lt;'EOF'
import json, sys, urllib.request

seuil = sys.argv[1]
rang = {"LOW": 1, "MODERATE": 2, "MEDIUM": 2, "HIGH": 3, "CRITICAL": 4}
try:
    data = json.load(open("pip-audit.json"))
except Exception as e:
    # fail closed : pas de rapport = pas de feu vert
    print("%-28s : KO - pip-audit n'a pas produit de rapport (%s)" % ("Dependances (pip-audit)", e))
    sys.exit(0)

osv_ko = []

def severite(ids):
    """pip-audit ne donne pas la severite : on la demande a OSV (avis GitHub)."""
    if osv_ko:
        return "ERREUR"
    for vid in [i for i in ids if i.startswith("GHSA-")]:
        try:
            with urllib.request.urlopen("https://api.osv.dev/v1/vulns/" + vid, timeout=15) as r:
                sev = json.load(r).get("database_specific", {}).get("severity")
                if sev:
                    return sev.upper()
        except Exception as e:
            print("  (OSV injoignable : %s)" % e, file=sys.stderr)
            osv_ko.append(vid)
            return "ERREUR"
    return "INCONNUE"

lignes, vues = [], set()
for dep in data.get("dependencies", []):
    for v in dep.get("vulns", []):
        if (dep["name"], v["id"]) in vues:
            continue
        vues.add((dep["name"], v["id"]))
        ids = [v["id"]] + v.get("aliases", [])
        cve = next((i for i in ids if i.startswith("CVE-")), v["id"])
        lignes.append((severite(ids), dep["name"], dep["version"], cve, ",".join(v.get("fix_versions", [])) or "-"))

lignes.sort(key=lambda l: -rang.get(l[0], 5))
print("%-9s %-12s %-9s %-16s %s" % ("SEVERITE", "PAQUET", "VERSION", "CVE", "CORRIGE EN"), file=sys.stderr)
for l in lignes:
    print("%-9s %-12s %-9s %-16s %s" % l, file=sys.stderr)

# fail closed : une severite qu'on n'a pas pu verifier compte comme bloquante
bloquantes = [l for l in lignes if l[0] == "ERREUR" or rang.get(l[0], 0) &gt;= rang[seuil]]
if osv_ko:
    print("%-28s : KO - %d CVE dont la severite n'a pas pu etre verifiee (OSV injoignable)" % ("Dependances (pip-audit)", len(lignes)))
elif bloquantes:
    detail = ", ".join("%s %s %s" % (l[1], l[2], l[3]) for l in bloquantes)
    print("%-28s : KO - %d CVE %s : %s" % ("Dependances (pip-audit)", len(bloquantes), seuil, detail))
else:
    print("%-28s : OK (%d CVE sous le seuil %s)" % ("Dependances (pip-audit)", len(lignes), seuil))
EOF
grep -q "^Dependances" gate-resultat.txt || resultat "Dependances (pip-audit)" "KO - analyse non executee"
tail -1 gate-resultat.txt
exit 0
</command>
        <configuredLocalRules/>
      </hudson.tasks.Shell>
{% if ci_sonar %}
      <hudson.plugins.sonar.SonarRunnerBuilder plugin="sonar">
        <project></project>
        <properties>sonar.projectKey=todolist
sonar.projectName=todolist
sonar.sources=tasks,todo,manage.py
sonar.tests=tasks
sonar.test.inclusions=**/tests.py
sonar.exclusions=**/tests.py,**/migrations/**,**/templates/**/*.css
sonar.coverage.exclusions=**/migrations/**,manage.py,todo/asgi.py,todo/wsgi.py
sonar.python.version=3.13
sonar.python.coverage.reportPaths=coverage.xml
sonar.scm.revision=${GIT_COMMIT}</properties>
        <javaOpts></javaOpts>
        <additionalArguments></additionalArguments>
        <jdk>(Inherit From Job)</jdk>
        <task></task>
        <installationName>sonarqube</installationName>
        <sonarScannerName>sonar-scanner</sonarScannerName>
      </hudson.plugins.sonar.SonarRunnerBuilder>
{% endif %}
      <hudson.tasks.Shell>
        <command>#!/bin/bash
# todolist-check-code - etape 3 : resultat SonarQube + verdict final de la gate
set -uo pipefail
GATE_BLOQUANTE={{ 'true' if ci_gate_bloquante else 'false' }}
{% if ci_sonar %}
echo "=== Quality gate SonarQube"
python3 &gt;&gt; gate-resultat.txt &lt;&lt;'EOF' || echo "Quality gate SonarQube       : KO - resultat illisible" &gt;&gt; gate-resultat.txt
import json, os, time, urllib.request

props = dict(l.strip().split("=", 1) for l in open(".scannerwork/report-task.txt") if "=" in l)
token = os.environ["SONAR_TOKEN"]

def api(chemin):
    req = urllib.request.Request(props["serverUrl"] + chemin, headers={"Authorization": "Bearer " + token})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)

for _ in range(60):
    tache = api("/api/ce/task?id=" + props["ceTaskId"])["task"]
    if tache["status"] in ("SUCCESS", "FAILED", "CANCELED"):
        break
    time.sleep(5)

if tache["status"] != "SUCCESS":
    print("%-28s : KO - analyse %s" % ("Quality gate SonarQube", tache["status"]))
else:
    statut = api("/api/qualitygates/project_status?analysisId=" + tache["analysisId"])["projectStatus"]
    if statut["status"] == "OK":
        print("%-28s : OK" % "Quality gate SonarQube")
    else:
        ko = ["%s=%s (seuil %s %s)" % (c["metricKey"], c.get("actualValue", "?"), c["comparator"], c["errorThreshold"])
              for c in statut.get("conditions", []) if c["status"] == "ERROR"]
        print("%-28s : KO - %s" % ("Quality gate SonarQube", ", ".join(ko)))
print("%-28s : %s" % ("Rapport SonarQube", props.get("dashboardUrl", "")))
EOF
{% endif %}
echo
echo "======================== RESULTAT DE LA GATE ========================"
cat gate-resultat.txt
echo "====================================================================="
if grep -q ": KO" gate-resultat.txt; then
  if [ "$GATE_BLOQUANTE" = "true" ]; then
    echo " ECHEC : le code ne passe pas la gate (lignes KO ci-dessus)."
    echo "         Rien ne sera deploye."
    exit 1
  fi
  echo " ATTENTION : problemes detectes, gate NON bloquante pour l'instant."
fi
echo " Gate franchie."
</command>
        <configuredLocalRules/>
      </hudson.tasks.Shell>
  </builders>
  <publishers>
    <hudson.tasks.ArtifactArchiver>
      <artifacts>gate-resultat.txt,pip-audit.json,gitleaks.json,coverage.xml,requirements-ci.txt</artifacts>
      <allowEmptyArchive>true</allowEmptyArchive>
      <onlyIfSuccessful>false</onlyIfSuccessful>
      <fingerprint>false</fingerprint>
      <defaultExcludes>true</defaultExcludes>
      <caseSensitive>true</caseSensitive>
      <followSymlinks>false</followSymlinks>
    </hudson.tasks.ArtifactArchiver>
  </publishers>
  <buildWrappers>
    <hudson.plugins.ws__cleanup.PreBuildCleanup plugin="ws-cleanup">
      <deleteDirs>false</deleteDirs>
      <cleanupParameter></cleanupParameter>
      <externalDelete></externalDelete>
      <disableDeferredWipeout>false</disableDeferredWipeout>
    </hudson.plugins.ws__cleanup.PreBuildCleanup>
    <hudson.plugins.timestamper.TimestamperBuildWrapper plugin="timestamper"/>
    <org.jenkinsci.plugins.builduser.BuildUser plugin="build-user-vars-plugin"/>
    <org.jenkinsci.plugins.credentialsbinding.impl.SecretBuildWrapper plugin="credentials-binding">
      <bindings>
{% if ci_sonar %}
          <org.jenkinsci.plugins.credentialsbinding.impl.StringBinding>
            <credentialsId>sonar-token</credentialsId>
            <variable>SONAR_TOKEN</variable>
          </org.jenkinsci.plugins.credentialsbinding.impl.StringBinding>
{% endif %}
      </bindings>
    </org.jenkinsci.plugins.credentialsbinding.impl.SecretBuildWrapper>
    <org.jenkinsci.plugins.buildnamesetter.BuildNameSetter plugin="build-name-setter">
      <template>#${BUILD_NUMBER} ${ENV,var="BRANCHE"}@${GIT_REVISION,length=8}</template>
      <descriptionTemplate></descriptionTemplate>
      <runAtStart>true</runAtStart>
      <runAtEnd>true</runAtEnd>
    </org.jenkinsci.plugins.buildnamesetter.BuildNameSetter>
  </buildWrappers>
</project>
