# J2 : ajout de la VM jenkins (Jenkins + SonarQube en conteneur).
# Machine hote a 8 Go : les VM app passent a 768 Mo pour laisser de la place.
VMS = {
  "app-dev"   => { ip: "192.168.56.10", mem: 768,  cpus: 1 },
  "app-prod1" => { ip: "192.168.56.11", mem: 768,  cpus: 1 },
  "jenkins"   => { ip: "192.168.56.20", mem: 3584, cpus: 2 },
}

PUBKEY = File.read(File.join(__dir__, "id-rda-infra.key.pub")).strip

Vagrant.configure("2") do |config|
  # debian 13 car django 6 a besoin de python >= 3.12
  config.vm.box = "bento/debian-13"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  VMS.each do |name, vm|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: vm[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name = name
        vb.memory = vm[:mem]
        vb.cpus = vm[:cpus]
      end

      node.vm.provision "shell", inline: <<-SHELL
        id admin || useradd -m -s /bin/bash admin
        echo 'admin ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/admin
        mkdir -p /home/admin/.ssh
        echo '#{PUBKEY}' > /home/admin/.ssh/authorized_keys
        chown -R admin:admin /home/admin/.ssh
        chmod 700 /home/admin/.ssh
        chmod 600 /home/admin/.ssh/authorized_keys
      SHELL
    end
  end
end
